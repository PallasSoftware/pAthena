<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Orleans" Version="13.5.4" />
    <!-- Aspire.Hosting.SqlServer pulls in 10.0.11 of this package (GHSA-846f-f764-76mx); pinned to the patched release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Aspire.Hosting -> StreamJsonRpc pulls in MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h, nested arrays can blow past buffer length limits); pinned to the patched 2.5.303. Remove when StreamJsonRpc depends on a patched MessagePack itself. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CharServer/CharServer.csproj" />
    <ProjectReference Include="../LoginServer/LoginServer.csproj" />
    <ProjectReference Include="../MapServer/MapServer.csproj" />
    <ProjectReference Include="../WorldServer/Athena.World/Athena.World.csproj" />
  </ItemGroup>
</Project>
