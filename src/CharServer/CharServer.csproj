<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Microsoft.Data.SqlClient 6.1.x pulls in 9.0.11 of this package (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); pinned to the patched 10.0 release until SqlClient does. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Net/AdvertisedIpv4.cs" Link="Shared/Net/AdvertisedIpv4.cs" />
    <Compile Include="../Shared/MapIdentity/CanonicalMapPolicy.cs" Link="Shared/MapIdentity/CanonicalMapPolicy.cs" />
    <Compile Include="../Shared/MapIdentity/Generated/GeneratedCanonicalMapAliases.cs" Link="Shared/MapIdentity/Generated/GeneratedCanonicalMapAliases.cs" />
  </ItemGroup>
</Project>
