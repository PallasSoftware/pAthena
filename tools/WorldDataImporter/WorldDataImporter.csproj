<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- One authoritative map-cache parser/layering resolver is compiled into both the runtime and offline analyzer. -->
    <Compile Include="../../src/MapServer/World/RathenaMapCacheFormat.cs" Link="Compiler/RathenaMapCacheFormat.cs" />
    <Compile Include="../../src/MapServer/World/RathenaMapCacheLayers.cs" Link="Compiler/RathenaMapCacheLayers.cs" />
    <Compile Include="../../src/MapServer/World/AthenaMapPackFormat.cs" Link="Compiler/AthenaMapPackFormat.cs" />
    <Compile Include="../../src/MapServer/World/GeneratedPackHeader.cs" Link="Compiler/GeneratedPackHeader.cs" />
    <Compile Include="../../src/MapServer/World/Items/ItemPackFormat.cs" Link="Compiler/ItemPackFormat.cs" />
    <Compile Include="../../src/MapServer/World/Items/ItemScriptIr.cs" Link="Compiler/ItemScriptIr.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Script identifier values resolved by the real pinned rAthena (tools/rathena-reference/run-data.ps1). -->
    <None Include="rathena-constants.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
