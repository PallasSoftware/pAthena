<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/WorldDataImporter/WorldDataImporter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MapServer item-script evaluator, compiled against the importer's own pack types so the data-driven fixture test can run a
         freshly converted script end to end (this project cannot reference MapServer.csproj, see ItemPipelineDataDrivenFixtureTests). -->
    <Compile Include="../../src/MapServer/World/Items/ItemScriptEvaluator.cs" Link="Linked/ItemScriptEvaluator.cs" />
  </ItemGroup>
</Project>
